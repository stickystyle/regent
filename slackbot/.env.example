# Regent Slack Bot Environment Variables
# Copy this file to .env and fill in the values

# Anthropic API Key for Claude Messages API
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# GitHub Personal Access Token or GitHub App credentials
# Required for repository exploration and spec storage
# Needs repo scope for private repositories
GITHUB_TOKEN=your_github_token_here

# HMAC secret for webhook callback validation
# Used to verify exploration callback authenticity
# Generate with: openssl rand -hex 32
CALLBACK_SECRET=your_callback_secret_here
