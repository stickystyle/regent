# Regent Slack Bot Environment Variables
# Copy this file to .env and fill in the values
# See docs/deployment.md for complete setup instructions

# Anthropic API Key for Claude Messages API
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# GitHub Personal Access Token or GitHub App credentials
# Required for repository exploration and spec storage
# Needs repo scope for private repositories
GITHUB_TOKEN=your_github_token_here

# HMAC secret for webhook callback validation
# Used to verify exploration callback authenticity
# Must match CALLBACK_SECRET in GitHub Actions secrets
# Generate with: openssl rand -hex 32
CALLBACK_SECRET=your_callback_secret_here

# URL for receiving exploration results from GitHub Actions (OPTIONAL)
# This is your Slack app's incoming webhook trigger endpoint
# Format: https://hooks.slack.com/triggers/{team_id}/{trigger_id}/{secret}
# This URL is passed to GitHub Actions when triggering repository exploration
# If not set, the workflow falls back to using SLACK_WEBHOOK_TRIGGER_URL GitHub secret
# SECURITY: This URL is a secret - never log it or include in error messages
# See docs/deployment.md for how to set this up
EXPLORATION_CALLBACK_URL=your_callback_url_here

# Repository hosting the exploration GitHub Actions workflow
# Format: owner/repo (exactly one slash, e.g., "myorg/exploration-service")
# This repo must have credentials to clone target repositories for brainstorm sessions
EXPLORATION_SERVICE_REPO=stickystyle/regent
